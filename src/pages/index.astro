---
import Layout from '../layouts/Layout.astro';
import { site } from '../site';

const captures = [
  { file: 'jaina-cone-of-cold', game: '风暴英雄', type: '角色 · 离屏渲染', title: '吉安娜', alt: '吉安娜屈膝施展寒冰锥，一手将冰晶法杖斜举向前，另一手张开。', width: 1104, height: 621 },
  { file: 'blademaster', game: '魔兽争霸 III', type: '角色 · 离屏渲染', title: '兽族剑圣', alt: '兽族剑圣手握宽刃长刀，背着蓝色战旗。', width: 960, height: 540 },
  { file: 'human-campaign', game: '魔兽争霸 III', type: '场景 · 视口截图', title: '人族战役第一章', alt: '从斜上方俯瞰人族村镇、林地与穿过地图的河流。', width: 560, height: 315 },
  { file: 'azeroth', game: '魔兽世界', type: '场景 · 视口截图', title: '艾泽拉斯山林', alt: '林间小径穿过针叶林，远处是浅色岩峰和蓝天。', width: 928, height: 522 },
];
---
<Layout title="探索资源，理解结构" description="开物有方，StormForge 产品介绍。面向本地合法安装的游戏，提供资源索引、模型与动画预览、材质和来源信息检查，让资源研究更直观。">
  <section class="hero">
    <div>
      <p class="eyebrow">开物有方 / STORMFORGE</p>
      <h1>探索资源，<br />理解结构。</h1>
      <p class="lead">StormForge 是面向本地游戏的资源研究与预览工具。连接合法安装的受支持游戏，在同一工作流中查找资源、观察模型与动画、理解内容结构。</p>
      <div class="actions">
        <a class="button primary" href="/features/">了解产品功能 <span aria-hidden="true">&nbsp;↗</span></a>
        <a class="button" href="/docs/">阅读入门文档</a>
      </div>
      <p class="fine">只读访问本地来源 · <a href="/download/">查看发行状态</a></p>
    </div>
    <aside class="product-summary" aria-label="StormForge 产品介绍">
      <div class="product-identity">
        <img src={site.icon} alt="StormForge 产品图标：青色立方体与金色中心" width="108" height="108" fetchpriority="high" />
        <div><p class="eyebrow">本地资源工作台</p><h2>StormForge</h2><p>游戏资源研究与预览工具</p></div>
      </div>
      <dl class="product-facts">
        <div><dt>连接来源</dt><dd>本机合法安装的受支持游戏</dd></div>
        <div><dt>观察内容</dt><dd>模型、材质、动画与场景</dd></div>
        <div><dt>工作方式</dt><dd>只读索引、检查与预览</dd></div>
      </dl>
      <p class="fine">Windows 桌面工具 · 公开发行准备中</p>
    </aside>
  </section>
  <section class="section" aria-labelledby="showcase">
    <div class="section-heading"><h2 id="showcase">CLI 实拍</h2><p>暴雪游戏的经典角色与场景</p></div>
    <p class="showcase-intro">用 StormForge 命令行捕获角色模型和场景视口，近看服装与武器，也能俯瞰地图布局。</p>
    <div class="showcase-grid">
      {captures.map(({ file, game, type, title, alt, width, height }) => (
        <figure>
          <img src={`/images/showcase/${file}.webp`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          <figcaption>
            <p>{game} <span aria-hidden="true">/</span> {type}</p>
            <h3>{title}</h3>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="fine showcase-credit">画面由 StormForge 预览渲染。游戏、角色与场景的相关权利归其权利人所有。</p>
  </section>
  <section class="section" aria-labelledby="capabilities">
    <div class="section-heading"><h2 id="capabilities">从资源目录，到内容细节。</h2><p>查找 · 预览 · 理解</p></div>
    <div class="grid">
      <article class="feature"><span class="number">01 / DISCOVER</span><h3>找到想研究的资源</h3><p>连接本地游戏来源，通过索引、搜索与筛选浏览资源目录，用收藏和集合整理关注的内容。</p></article>
      <article class="feature"><span class="number">02 / OBSERVE</span><h3>看清模型与动作</h3><p>在预览窗口中观察模型、材质和骨骼动画，调整取景与显示参数，检查不同资源的表现。</p></article>
      <article class="feature"><span class="number">03 / UNDERSTAND</span><h3>理解来源与结构</h3><p>查看来源格式、资源引用和相关信息，结合诊断结果区分已支持的内容与当前限制。</p></article>
    </div>
  </section>
  <section class="section" aria-labelledby="workflow">
    <div class="section-heading"><h2 id="workflow">从本地安装开始</h2><a href="/docs/">查看使用指南 ↗</a></div>
    <div class="workflow-steps">
      <div class="step"><span>01</span><div><h3>选择游戏来源</h3><p>确认合法拥有并安装游戏，连接受支持的本地来源。</p></div></div>
      <div class="step"><span>02</span><div><h3>建立资源索引</h3><p>由你启动索引，再通过目录与搜索找到研究对象。</p></div></div>
      <div class="step"><span>03</span><div><h3>打开并观察</h3><p>加载资源，查看结构、选择可用动作并检查预览结果。</p></div></div>
    </div>
  </section>
  <section class="section boundary">
    <h2>只读研究，<br />尊重内容。</h2>
    <div><p>StormForge 不分发原游戏资源，也不修改游戏资源或客户端。你需要合法拥有并安装受支持的游戏，并确认相关内容的使用权利。</p><p>预览用于学习、研究与检查，不承诺所有资源都受支持，或与原客户端画面完全一致。第三方名称仅用于兼容说明，不代表厂商关联或背书。</p></div>
  </section>
  <section class="section contact-strip" aria-labelledby="contact">
    <div><p class="eyebrow">保持联系</p><h2 id="contact">交流想法，反馈问题。</h2><p>产品咨询、使用反馈与合作联系，欢迎通过邮箱与我们交流。</p></div>
    <a class="button" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">&nbsp;↗</span></a>
  </section>
</Layout>

<style>
  .showcase-intro { color: var(--muted); margin-bottom: 24px; }
  .showcase-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  figure { margin: 0; border: 1px solid var(--line); background: var(--surface); }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { padding: 16px 20px; }
  figcaption p { margin: 0 0 4px; color: var(--muted); font-size: 14px; }
  figcaption span { color: var(--accent); margin-inline: 4px; }
  figcaption h3 { margin: 0; }
  .showcase-credit { margin: 16px 0 0; }
  @media (max-width: 680px) { .showcase-grid { grid-template-columns: 1fr; gap: 16px; } }
</style>
