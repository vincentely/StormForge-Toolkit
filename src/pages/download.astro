---
import Layout from '../layouts/Layout.astro';
import { desktopChannels, desktopPackages } from '../../scripts/desktop-releases.mjs';
import { readChannel } from '../../scripts/manifest.mjs';

const integrations = desktopChannels.filter(channel => channel.webDownload).flatMap(channel => {
  const manifest = readChannel(channel.id === 'dist' ? 'stable' : channel.id);
  return manifest ? [manifest] : [];
});
const channels = [...desktopChannels].sort((a, b) => Number(b.webDownload) - Number(a.webDownload));
const bytes = new Intl.NumberFormat('zh-CN');
const size = (value: number) => value < 1048576
  ? `${(value / 1024).toFixed(0)} KiB` : `${(value / 1048576).toFixed(1)} MiB`;
---
<Layout title="下载 StormHub 和 StormForge" description="下载 Windows x64 测试版 StormHub 和 StormForge。稳定版下载将于后续开放。">
  <header class="page-head">
    <p class="eyebrow">Windows x64</p>
    <h1>下载 StormForge</h1>
    <p class="lead">首次使用，下载 StormHub 并解压，双击 <code>StormHub.exe</code> 即可安装和更新 StormForge。也可以单独下载 StormForge 便携版。</p>
  </header>
  <div class="download-grid">
    {channels.map(({ id, label, webDownload }) => (
      <section class="release-card" aria-labelledby={id}>
        <h2 id={id}>{label} <span>{id}</span></h2>
        <p class="channel-caption">{webDownload ? '当前可从官网下载。首次安装建议使用 StormHub。' : '稳定版开放后，可在这里取得对应安装包。'}</p>
        {desktopPackages.filter(p => p.channel === id).map(p => (
          <article class="download-product" data-product={p.product} data-channel={id}>
            <div class="product-name">
              <img src={p.product === 'hub' ? '/images/stormhub-icon.png' : '/images/stormforge-icon.png'} width="44" height="44" alt="" />
              <div><h3>{p.name}</h3><p>{p.product === 'hub' ? '安装、更新和管理应用' : '查看和预览本机游戏资源'}</p></div>
            </div>
            {!webDownload ? <>
              <p class="fine">Windows x64 · 后续开放</p>
              <button type="button" class:list={['button', { primary: p.product === 'hub' }]} commandfor="dist-notice" command="show-modal" aria-haspopup="dialog" aria-label={`下载 ${p.name} ${label} Windows x64`}>下载 {p.name}</button>
            </> : <>
              <p class="fine"><time>{p.version}</time> · Windows x64 · <span data-size>{size(p.size_bytes)}</span></p>
              <a class:list={['button', { primary: p.product === 'hub' }]} href={p.url} data-bytes={p.size_bytes} data-sha256={p.sha256} aria-label={`下载 ${p.name} ${label} Windows x64`}>下载 {p.name}</a>
              <details><summary>大小与 SHA-256</summary><p data-bytes-label>{bytes.format(p.size_bytes)} 字节</p><code>{p.sha256}</code><a href={p.checksum}>下载 SHA-256 校验文件</a></details>
            </>}
          </article>
        ))}
      </section>
    ))}
  </div>
  <dialog id="dist-notice" aria-labelledby="dist-notice-title" aria-describedby="dist-notice-message">
    <h2 id="dist-notice-title">稳定版下载</h2>
    <p id="dist-notice-message">后续开放。</p>
    <form method="dialog"><button class="button primary">知道了</button></form>
  </dialog>
  <p class="download-help"><a href="/docs/#install">首次安装与更新</a> · <a href="/docs/#verify">如何核对下载文件</a></p>
  <p id="channel-status" role="status" hidden>暂时无法检查测试版更新。仍可下载页面列出的测试版。</p>
  {integrations.length > 0 && <section class="prose"><h2>其他发行包</h2>
    {integrations.map(manifest => <section>
      <h3>{manifest.version} · {manifest.channel === 'stable' ? '稳定版' : '测试版'}</h3>
      <p><time datetime={manifest.published_at}>{manifest.published_at}</time> · <a href={manifest.release_notes_url}>版本说明</a></p>
      {manifest.artifacts.map(a => <article>
        <h4>{a.filename}</h4><p>{a.platform} / {a.architecture} · {bytes.format(a.size_bytes)} 字节</p>
        <p>SHA-256 <code>{a.sha256}</code><br />来源提交 <code>{a.source_commit}</code></p>
        <p><a href={a.primary_url}>下载</a> · <a href={a.github_url}>GitHub 镜像</a></p>
      </article>)}
    </section>)}
  </section>}
</Layout>
<script>
  import { refreshDesktopDownloads } from '../desktop-downloads';
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    const notice = document.querySelector<HTMLDialogElement>('#dist-notice');
    for (const button of document.querySelectorAll('button[commandfor="dist-notice"]')) {
      button.addEventListener('click', () => notice?.showModal());
    }
  }
  void refreshDesktopDownloads();
</script>
<style>
  .download-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .download-grid .release-card { margin: 0; padding: clamp(20px, 3vw, 38px); }
  .release-card h2 { margin: 0; font: 550 clamp(1.7rem,2.6vw,2.4rem)/1.3 var(--display); }
  .channel-caption { margin: .45rem 0 1.1rem; color: var(--muted); font-size: .89rem; }
  .release-card:has(#dist) button { background: var(--wash); border-color: var(--line); color: var(--prose); }
  .release-card h2 span { font: normal .95rem Consolas, monospace; color: var(--muted); }
  .download-product { padding-block: 22px; border-top: 1px solid var(--line); min-width: 0; }
  .download-product:last-child { padding-bottom: 0; }
  .product-name { display: flex; align-items: center; gap: 12px; }
  .product-name img { object-fit: contain; flex: none; }
  .product-name h3, .product-name p { margin: 0; }
  .product-name p, .download-product details { font-size: .92rem; color: var(--prose); }
  .download-product .fine { margin: 12px 0; }
  button.button { font-family: inherit; line-height: inherit; cursor: pointer; }
  button.button:not(.primary) { color: var(--text); background: transparent; }
  dialog { width: min(24rem, calc(100% - 2rem)); padding: 28px; border: 1px solid var(--line); background: var(--bg); color: var(--text); }
  dialog::backdrop { background: rgb(0 0 0 / 50%); }
  dialog h2 { margin: 0 0 8px; }
  dialog p { margin: 0 0 24px; color: var(--prose); }
  dialog form { text-align: right; }
  .download-product details { margin-top: 12px; }
  .download-product summary { cursor: pointer; }
  .download-product details p { margin: 8px 0 0; }
  .download-product details code { display: block; overflow-wrap: anywhere; }
  .download-help { margin: 28px 0 48px; }
  @media (max-width: 700px) { .download-grid { grid-template-columns: 1fr; } }
</style>
