{
  "name": "stormforge-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/validate-release.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "validate:release": "node scripts/validate-release.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "package:site": "node scripts/package-site.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
