{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stormforge.vollagames.com/release/schema/manifest.v1.schema.json",
  "title": "StormForge release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "version", "published_at", "release_notes_url", "artifacts"],
  "properties": {
    "schema": { "const": "stormforge.release.v1" },
    "channel": { "enum": ["stable", "beta"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 80 },
    "published_at": { "type": "string", "format": "date-time" },
    "release_notes_url": { "$ref": "#/definitions/https" },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "platform", "architecture", "filename", "size_bytes", "sha256", "primary_url", "github_url", "source_commit"],
      "properties": {
        "kind": { "enum": ["toolkit", "unity", "unreal"] },
        "platform": { "enum": ["windows", "cross-platform"] },
        "architecture": { "enum": ["x64", "arm64", "any"] },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,179}\\.(zip|exe|tar\\.gz)$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "primary_url": { "$ref": "#/definitions/https" },
        "github_url": { "$ref": "#/definitions/https" },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    } }
  },
  "definitions": { "https": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 } }
}
